#include <stdio.h>


int main(){
    int numero, soma = 0, contador = 0;

    do{
        scanf("%d",& numero);

        if(numero >= 0 || numero <= 255){
            soma += numero;
            contador = contador+1;
        }
    }while(numero != -1);

    printf("soma = %d", soma);
    printf("quantidade = %d", contador);

    return;
}
